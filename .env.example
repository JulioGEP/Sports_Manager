# Variables de entorno. Copia este fichero a .env solo para desarrollo local.
# Ningún secreto se commitea. En Netlify se configuran por contexto en la interfaz o con `netlify env:set`.

# --- Bloque 1 ---
# Cadena de conexión a Postgres. En Netlify la inyecta la plataforma (Netlify Database).
# En local la inyecta `netlify dev` al arrancar la base local. No hace falta definirla a mano.
# NETLIFY_DB_URL=

# Dominio base de la plataforma, sin protocolo. Provisional.
# Producción: el dominio real. Local: sportsmanager.localhost (ver docs/deploy.md).
APP_BASE_DOMAIN=sportsmanager.localhost

# --- Bloque 3 ---
# Club que sirve la API cuando el host no lleva subdominio de club: dominio base a secas,
# localhost, deploy previews y branch deploys (ADR 0016). Debe existir en `organizations`.
TENANT_FALLBACK_SLUG=demo

# Secreto de firma de sesiones de Better Auth (mínimo 32 caracteres, `openssl rand -base64 48`).
# En local y en tests no hace falta: se usa uno de desarrollo. Fuera de local es obligatorio.
# BETTER_AUTH_SECRET=

# Dominio de la cookie de sesión para compartirla entre subdominios (ADR 0006). Solo cuando
# exista dominio propio; vacío = cookie de host único. Ejemplo: .sportsmanager.com
# SESSION_COOKIE_DOMAIN=

# Caducidad de las invitaciones en días. Por defecto 7.
# INVITATION_TTL_DAYS=7

# --- Bloque 4 ---
# Transporte de email (ADR 0018): `outbox` guarda los emails en la tabla email_outbox sin enviarlos
# (modo hasta tener dominio verificado en Resend); `resend` los envía por la API de Resend.
EMAIL_TRANSPORT=outbox

# Solo con EMAIL_TRANSPORT=resend. Clave de API de Resend (secreto) y remitente con dominio verificado.
# RESEND_API_KEY=
# EMAIL_FROM=Sports Manager <no-reply@tu-dominio>

# Escribe cada email en el log de la función. Solo deploy previews y local; en producción nunca.
# Con `netlify dev` se activa solo.
# EMAIL_DEBUG_LOG=true
