{
  "$meta": {
    "name": "Design System · SaaS de gestión de clubes",
    "version": "1.0.0",
    "date": "2026-10-20",
    "notes": "Tokens fijos. Los colores del club son dinámicos y los genera src/theme/clubTheme.ts a partir del color principal y secundario de cada club."
  },
  "font": {
    "sans": "\"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "text": {
    "mobile": {
      "display": {
        "size": "28px",
        "lineHeight": "34px",
        "weight": 600,
        "letterSpacing": "-0.035em"
      },
      "title1": {
        "size": "22px",
        "lineHeight": "28px",
        "weight": 600,
        "letterSpacing": "-0.025em"
      },
      "title2": { "size": "18px", "lineHeight": "24px", "weight": 600, "letterSpacing": "-0.01em" },
      "body": { "size": "16px", "lineHeight": "24px", "weight": 400, "letterSpacing": "0" },
      "secondary": { "size": "14px", "lineHeight": "20px", "weight": 400, "letterSpacing": "0" },
      "label": { "size": "12px", "lineHeight": "16px", "weight": 500, "letterSpacing": "0" },
      "figure": { "family": "mono", "size": "16px", "lineHeight": "24px", "weight": 500 }
    },
    "desktop": {
      "display": {
        "size": "40px",
        "lineHeight": "44px",
        "weight": 600,
        "letterSpacing": "-0.04em"
      },
      "title1": { "size": "28px", "lineHeight": "34px", "weight": 600, "letterSpacing": "-0.03em" },
      "title2": { "size": "20px", "lineHeight": "28px", "weight": 600, "letterSpacing": "-0.02em" },
      "body": { "size": "16px", "lineHeight": "24px", "weight": 400, "letterSpacing": "0" },
      "secondary": { "size": "14px", "lineHeight": "20px", "weight": 400, "letterSpacing": "0" },
      "label": { "size": "12px", "lineHeight": "16px", "weight": 500, "letterSpacing": "0" },
      "figure": { "family": "mono", "size": "16px", "lineHeight": "24px", "weight": 500 }
    },
    "rules": {
      "minSize": "12px",
      "minReadingSize": "14px",
      "figures": "Siempre Geist Mono o tabular-nums"
    }
  },
  "space": {
    "base": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px"
    },
    "screenMargin": { "mobile": "16px", "mobileEnvolvente": "20px", "desktop": "32px" }
  },
  "size": {
    "touchMin": { "mobile": "48px", "desktop": "44px" },
    "control": { "mobile": "48px", "desktop": "44px" },
    "ctaFixed": "52px",
    "listRow": { "mobile": "64px", "desktop": "52px" },
    "tabBar": "64px",
    "segmentButton": "44px",
    "avatar": { "row": "40px", "table": "32px" },
    "crest": { "header": "40px", "hero": "48px", "heroLarge": "72px" },
    "heroBand": "6px"
  },
  "shape": {
    "envolvente": {
      "context": "App de familias y entrenadores (móvil y tableta)",
      "radius": {
        "card": "24px",
        "sheet": "28px",
        "hero": "0 0 32px 32px",
        "control": "999px",
        "field": "16px",
        "chip": "999px",
        "row": "999px",
        "tabBar": "28px",
        "screen": "32px"
      },
      "shadow": {
        "card": "0 2px 6px rgba(11,13,18,0.05), 0 12px 32px rgba(11,13,18,0.06)",
        "row": "0 1px 3px rgba(11,13,18,0.06), 0 6px 16px rgba(11,13,18,0.04)",
        "float": "0 8px 28px rgba(11,13,18,0.14)",
        "cta": "0 8px 24px <club-fill a 28%>"
      }
    },
    "precisa": {
      "context": "Panel de gestión en escritorio (coordinación y administración)",
      "radius": {
        "card": "10px",
        "sheet": "12px",
        "hero": "16px",
        "control": "8px",
        "field": "8px",
        "chip": "6px",
        "row": "0",
        "tabBar": "0",
        "screen": "0"
      },
      "shadow": {
        "card": "none",
        "row": "none",
        "float": "0 8px 24px rgba(11,13,18,0.12)",
        "cta": "none"
      }
    }
  },
  "color": {
    "ink": "#0B0D12",
    "white": "#FFFFFF",
    "neutralFallback": {
      "light": {
        "surfacePage": "#F5F7F6",
        "surface": "#FFFFFF",
        "surfaceRaised": "#EEF0F3",
        "border": "#E3E6EB",
        "line": "#EEF0F3",
        "text": "#0B0D12",
        "textMuted": "#5B6271",
        "control": "#D5DAE0"
      },
      "dark": {
        "surfacePage": "#0E1014",
        "surface": "#16181D",
        "surfaceRaised": "#22252B",
        "border": "#2E323A",
        "line": "#262A31",
        "text": "#F2F3F5",
        "textMuted": "#A3AAB5",
        "control": "#3A3F47"
      }
    },
    "status": {
      "success": {
        "light": { "bg": "#E6F4EC", "text": "#116A3E" },
        "dark": { "bg": "#123524", "text": "#7FD8A8" }
      },
      "warning": {
        "light": { "bg": "#FFF1DB", "text": "#8A4B00" },
        "dark": { "bg": "#3A2A12", "text": "#F5C26B" }
      },
      "danger": {
        "light": { "bg": "#FDECEC", "text": "#B4232A", "solid": "#B4232A", "border": "#F2C4C6" },
        "dark": { "bg": "#3B1416", "text": "#FF9A9F", "solid": "#C9343B", "border": "#5C2226" }
      },
      "info": {
        "light": { "bg": "#EEF2FF", "text": "#2448D8" },
        "dark": { "bg": "#18224A", "text": "#9DB2FF" }
      },
      "neutral": {
        "light": { "bg": "#EEF0F3", "text": "#5B6271" },
        "dark": { "bg": "#22252B", "text": "#A3AAB5" }
      }
    },
    "chart": {
      "teamReference": "#8A919C",
      "belowMedian": "#8A919C",
      "grid": "#EEF0F3"
    },
    "product": {
      "cobalt": "#2F5BFF",
      "usage": "Solo fuera del club: acceso, alta, facturación del SaaS y web. Nunca dentro de la app de un club."
    }
  },
  "motion": {
    "status": "Propuesta, pendiente de validar",
    "duration": { "fast": "150ms", "base": "250ms", "sheet": "300ms" },
    "easing": { "out": "cubic-bezier(0.2, 0, 0, 1)", "in": "cubic-bezier(0.4, 0, 1, 1)" },
    "toastDuration": "4000ms",
    "reducedMotion": "Respetar prefers-reduced-motion: sin desplazamientos, solo fundidos de 150ms"
  },
  "icons": {
    "library": "Phosphor (licencia MIT), peso duotone",
    "grid": "24px",
    "sizes": { "inline": "16px", "default": "22px", "large": "26px", "feature": "36px" },
    "stroke": "1.75 en iconos propios",
    "duoFill": "var(--icon-duo): texto del club al 16 % (20 % en oscuro)",
    "duoFillActive": "var(--icon-duo-active): 28 % (32 % en oscuro)"
  },
  "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
