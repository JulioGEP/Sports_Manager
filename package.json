{
  "name": "sportsmanager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "netlify dev --filter @sportsmanager/api",
    "build": "pnpm --filter @sportsmanager/api build && pnpm --filter @sportsmanager/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:isolation": "pnpm --filter @sportsmanager/api test:isolation",
    "db:generate": "pnpm --filter @sportsmanager/db generate",
    "db:migrate": "netlify database migrations apply",
    "db:status": "netlify database status",
    "db:check": "bash scripts/check-migrations.sh",
    "dev:servers": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @sportsmanager/api dev\" \"pnpm --filter @sportsmanager/web dev\"",
    "test:ui": "pnpm --filter @sportsmanager/web e2e"
  },
  "dependencies": {
    "@netlify/database": "2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "netlify-cli": "27.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
